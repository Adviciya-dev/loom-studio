{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Loom",
  "version": "0.2.9",
  "identifier": "com.loom.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Loom",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src blob: 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/loom-engine"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMDhCMEE5QTRDNEZBQ0IKUldUTCtzU2txYkFJSCt0aUU2NGt1M2JxSnNuREs4cWNrcmIvZ01qSzN1MHlaRTJHTm44ZWJiOWEK",
      "endpoints": [
        "https://github.com/Adviciya-dev/loom-studio/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
